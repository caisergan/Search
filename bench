#!/usr/bin/env python3
"""Drive the Search you already have open, from the shell.

    ./bench tabs                       every tab, yours and the bench's
    ./bench open URL                   a bench tab at the end of the row → its id
    ./bench go ID URL                  send a bench tab somewhere else
    ./bench wait ID [SECONDS]          until the page has loaded
    ./bench sleep ID                   put a tab to sleep now, or say what keeps it awake
    ./bench select ID                  bring a tab to the front — --test runs only
    ./bench resize W H [STEPS]         take the window to W×H in steps, like a drag — --test runs only
    ./bench key ID TEXT                press keys on a tab as real key events — --test runs only
    ./bench press CODE CHARS [MODS…]   press a key on the whole app (cmd shift ctrl opt, repeat) — --test runs only
    ./bench tap ID SELECTOR [MODS…]    a real mouse click on an element (or text=Words), keys held (cmd shift ctrl opt) — --test runs only
    ./bench text ID                    the page's text
    ./bench eval ID JS [search]        run JavaScript, print what it returns; search: in Search's own world
    ./bench click ID SELECTOR
    ./bench type ID SELECTOR TEXT
    ./bench submit ID SELECTOR         the form around SELECTOR
    ./bench shot ID [PATH] [WIDTH]     a PNG of the page → its path
    ./bench close ID | all             only tabs the bench opened
    ./bench probe                      the window's own state: panels, modal, windows
    ./bench extensions                 installed extensions, loaded or not, with their warnings
    ./bench little URL|keep|close      a small window for a link (made unseen), kept into the row, or closed
    ./bench sync [state|use|keep]      settings through iCloud Drive: what it has; use another Mac's (opens again), keep this one's — --test runs only
    ./bench site PATH [security|permissions]  the site card for the tab on screen, drawn to a PNG
    ./bench ext-add ID|LINK [--yes]    install from the Chrome Web Store (--yes only in a --test run)
    ./bench ext-folder PATH [--yes]    install an unpacked extension
    ./bench ext-press ID               press its button
    ./bench ext-page ID [PATH]         one of its pages in a bench tab → tab id, for eval
    ./bench ext-popup ID JS            run JavaScript in its popup while it is open
    ./bench ext-reload ID              take it up again (a folder one is copied in afresh)
    ./bench ext-pin ID [on|off]        keep its button in the row beside the puzzle
    ./bench ext-menu PATH              the puzzle button's list, drawn to a PNG
    ./bench ext-shot ID PATH           a picture of its popup while it is open
    ./bench ext-answer yes|no|ask      test run: answer extensions' questions without asking; lists what was asked
    ./bench ext-enable ID on|off       switch an extension on or off
    ./bench ext-remove ID
    ./bench strip PATH [WIDTH]         the row of tabs across the top, drawn off screen to a PNG
    ./bench column PATH [HEIGHT]       the column of tabs, drawn off screen to a PNG
    ./bench consent [grant|revoke]     test run: the mark Settings' bench switch leaves in the keychain, in this
                                       world's own account — whether it is there, before and after
    ./bench fold PATH [WIDTH]          test run: the folded strip or column out over the page (ui folded on,
                                       ui peek on), drawn off screen over red — red shows where the page would
    ./bench space [new NAME [fresh]|go N|delete|swipe DX|hold DX|release|move N]
                                       test run: the spaces, a new one (signed in with the others, or fresh),
                                       switch to the Nth, delete this one,
                                       two fingers DX points sideways over the column (hold: not let go yet),
                                       move this one to Nth
    ./bench downloads [ACTION]         test run: every download, with its state, bytes and pace;
                                       fetch ID URL through a tab, pause|resume|cancel|restart|remove N,
                                       clear, quit as ⌘Q would without asking, list PATH (the button's
                                       list drawn to a PNG), popover on|off, hand PATH (a file handed
                                       over as the PDF viewer's download button hands it), pdf-save (that
                                       button itself, pressed, on the PDF in the tab on screen)
    ./bench hit X Y [double|middle]    what a press at X Y (points from the window's top left) lands on,
                                       and whether a drag from there would move the window;
                                       double: test run, a double-click there (start the probe hidden)
    ./bench place ID INDEX             put a tab at another place in the row
    ./bench pin ID essential|line|none|close   a square, a pinned line or neither; close puts it down
    ./bench pin clear                  Clear: every tab that is neither goes
    ./bench leave [stay|go]            test run: the question a page with unsaved changes raises before it is
                                       left or its tab closed — whether one is up and what it says; stay and
                                       go answer it as its buttons do
    ./bench close-after ID [close|others]  test run: Close Tabs Below (or to the Right) from that tab's menu —
                                       what it is called and how many tabs it would close; close: closes
                                       them; others: Close Other Tabs, the line above it
    ./bench field TEXT [type] [go]     test run: TEXT pasted into the address field (type: a key at a time),
                                       each timed until the window has caught up; go: then Return, timed
                                       until the page is loading
    ./bench pull DX [STEPS] [MS]       test run: two fingers DX points sideways over the page (back is +) — where it went
    ./bench keyeq CHARS CODE [shift]   test run: ⌘CHARS pressed while the page has the keyboard — who took it
    ./bench find [TEXT [type] | next|previous [N] | close]
                                       test run: Find on Page in the tab in front — TEXT put in its field
                                       (type: a letter at a time, without a wait), the next match or the one
                                       before (N of them at once), or the bar closed: what it says ("3/12")
                                       and the match selected
    ./bench menu [open]                test run: the Bookmarks menu as it is about to open, and its first
                                       folder (open: its first bookmark picked)
    ./bench transfer [NAME]            test run: Tabs › Transfer Tabs as the menu bar has it, and the row
                                       (NAME: that browser picked under Bring Tabs from)
    ./bench bookmark URL [new]         test run: a bookmark picked from the list, timed until it loads
                                       (new: into a new tab, whose page isn't built yet)
    ./bench history [clear]            test run: how many places the History window lists and how many
                                       its file holds right now; clear: History › Clear History first
    ./bench peek URL|close             test run: the peek panel over the tab in front, as a shift-click opens it
    ./bench window                     test run: open the browser's window if a hidden probe came up without it
    ./bench windowfs                   test run: the window in or out of full screen, as the green button does
    ./bench files open PATH…|import PATH|export PATH|menu
                                       test run: pages on this Mac opened as File › Open File… opens them, or
                                       bookmarks in from or out to an HTML file, without the panels; menu:
                                       the File and Bookmarks menus' lines, with their keys
    ./bench permit [allow|deny|set HOST KIND allow|block|ask|forget [HOST]|popup-open|popup-allow|pause|click-page|click-worker|picture PATH|ask KIND|pop]
                                       what sites were allowed, the question at the top of the page, the pop-up notice,
                                       what the tab on screen has of the camera, microphone and screen; answering
                                       and changing them only on a --test run, where notifications are kept, not shown;
                                       ask KIND and pop: the page on screen asking for it, or opening a window by itself
    ./bench front                      test run: the window on screen, in front and key, for a page that only asks
                                       for the camera, location or the screen while focused (pages on puts it away)
    ./bench translate ID [on|off|read]  what the page is written in, and whether it is translated; on (test run:
                                       each piece marked, not translated), off (the original back), read (again)
    ./bench autofill [add-contact KEY=VALUE… | add-card NUMBER MM/YYYY [NAME] | pick N | strong | clear | picture PATH]
                                       addresses and cards kept, and what hangs from the box the caret is in;
                                       adding, picking and clearing only on a --test run
    ./bench pages on|off               test run: let a hidden probe's pages be painted, off every screen (for picture)
    ./bench picture PATH               test run: the whole window, pages included, drawn to a PNG (start the probe hidden)
    ./bench film peek|unpeek|fold PATH [N] [SECS]  the window drawn N times while it animates → PATH-00.png… — --test runs only
    ./bench ui KEY VALUE               settings/passwords/welcome/history/downloads/bookmarks/hidden on|off,
                                       look light|dark|system, sidebar on|off, spaces on|off, hides on|off,
                                       folded on|off, peek on|off, pinnedfolded on|off, glance keep|off, peeklink keep|close, pages120 on|off

Needs Settings › General › "Let a script drive Search" switched on in the
running app. IDs are the first characters of a tab's id, as `tabs` prints
them. With --test, talks to a SEARCH_PROBE run instead of the real one;
with --world NAME, to a SEARCH_PROBE=NAME run, the world "Search (NAME)".
"""

import json
import os
import socket
import sys

def folder(world):
    name = f"Search ({world})" if world else "Search"
    return os.path.expanduser(f"~/Library/Application Support/{name}")

def ask(path, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        try:
            s.connect(path)
        except (FileNotFoundError, ConnectionRefusedError):
            sys.exit("Search isn't listening — is it open, with Settings › General › "
                     "“Let a script drive Search” on?")
        s.sendall((json.dumps(request) + "\n").encode())
        chunks = []
        while True:
            chunk = s.recv(1 << 16)
            if not chunk:
                break
            chunks.append(chunk)
    line = b"".join(chunks).split(b"\n", 1)[0]
    return json.loads(line or b"{}")

def main(argv):
    world = "test" if "--test" in argv else None
    if "--world" in argv:
        at = argv.index("--world")
        if at + 1 >= len(argv): sys.exit("usage: bench --world NAME COMMAND …")
        world = "".join(c for c in argv[at + 1].lower() if c.isascii() and (c.isalnum() or c == "-"))
        if world in ("", "1"): world = "test"
        argv = argv[:at] + argv[at + 2:]
    yes = "--yes" in argv
    argv = [a for a in argv if a not in ("--test", "--yes")]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    verb, args = argv[0], argv[1:]
    request = {"do": verb}
    if verb == "open":
        if len(args) != 1: sys.exit("usage: bench open URL")
        request["url"] = args[0]
    elif verb == "go":
        if len(args) != 2: sys.exit("usage: bench go ID URL")
        request["id"], request["url"] = args
    elif verb in ("wait",):
        if not args: sys.exit("usage: bench wait ID [SECONDS]")
        request["id"] = args[0]
        if len(args) > 1: request["seconds"] = float(args[1])
    elif verb in ("text", "close", "sleep", "select"):
        if len(args) != 1: sys.exit(f"usage: bench {verb} ID")
        request["id"] = args[0]
    elif verb == "eval":
        if len(args) not in (2, 3) or (len(args) == 3 and args[2] != "search"): sys.exit("usage: bench eval ID JS [search]")
        request["id"], request["js"] = args[0], args[1]
        if len(args) == 3: request["world"] = "search"
    elif verb == "tap":
        if len(args) < 2: sys.exit("usage: bench tap ID SELECTOR [MODS…]")
        request["id"], request["selector"], request["mods"] = args[0], args[1], args[2:]
    elif verb in ("click", "submit"):
        if len(args) != 2: sys.exit(f"usage: bench {verb} ID SELECTOR")
        request["id"], request["selector"] = args
    elif verb == "type":
        if len(args) != 3: sys.exit("usage: bench type ID SELECTOR TEXT")
        request["id"], request["selector"], request["text"] = args
    elif verb == "shot":
        if not args: sys.exit("usage: bench shot ID [PATH] [WIDTH]")
        request["id"] = args[0]
        if len(args) > 1: request["path"] = os.path.abspath(args[1])
        if len(args) > 2: request["width"] = float(args[2])
    elif verb == "ui":
        if len(args) != 2: sys.exit("usage: bench ui KEY VALUE")
        key, value = args
        request[key] = value if key in ("look", "edittab", "glance", "peeklink") else value in ("on", "true", "1", "yes")
    elif verb in ("ext-add", "ext-press", "ext-remove", "ext-reload"):
        if len(args) != 1: sys.exit(f"usage: bench {verb} ID")
        request["id"] = args[0]
        request["yes"] = yes
    elif verb == "ext-enable":
        if len(args) != 2: sys.exit("usage: bench ext-enable ID on|off")
        request["id"] = args[0]
        request["on"] = args[1] in ("on", "true", "1", "yes")
    elif verb == "ext-pin":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench ext-pin ID [on|off]")
        request["id"] = args[0]
        request["on"] = (args[1] if len(args) > 1 else "on") in ("on", "true", "1", "yes")
    elif verb == "ext-answer":
        if len(args) != 1 or args[0] not in ("yes", "no", "ask"): sys.exit("usage: bench ext-answer yes|no|ask")
        request["answer"] = args[0]
    elif verb == "ext-shot":
        if len(args) != 2: sys.exit("usage: bench ext-shot ID PATH")
        request["id"] = args[0]
        request["path"] = os.path.abspath(args[1])
    elif verb == "ext-menu":
        if len(args) != 1: sys.exit("usage: bench ext-menu PATH")
        request["path"] = os.path.abspath(args[0])
    elif verb == "ext-folder":
        if len(args) != 1: sys.exit("usage: bench ext-folder PATH")
        request["path"] = os.path.abspath(args[0])
        request["yes"] = yes
    elif verb == "ext-popup":
        if len(args) != 2: sys.exit("usage: bench ext-popup ID JS")
        request["id"], request["js"] = args
    elif verb == "ext-page":
        if not args: sys.exit("usage: bench ext-page ID [PATH]")
        request["id"] = args[0]
        request["path"] = args[1] if len(args) > 1 else ""
    elif verb == "press":
        if len(args) < 2: sys.exit("usage: bench press KEYCODE CHARS [cmd] [shift] [ctrl] [opt]")
        request["code"], request["chars"], request["mods"] = int(args[0]), args[1], args[2:]
    elif verb == "key":
        if len(args) != 2: sys.exit("usage: bench key ID TEXT")
        request["id"], request["text"] = args
    elif verb == "resize":
        if len(args) not in (2, 3): sys.exit("usage: bench resize WIDTH HEIGHT [STEPS]")
        request["width"], request["height"] = float(args[0]), float(args[1])
        if len(args) == 3: request["steps"] = int(args[2])
    elif verb == "strip":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench strip PATH [WIDTH]")
        request["path"] = os.path.abspath(args[0])
        if len(args) == 2: request["width"] = float(args[1])
    elif verb == "consent":
        if len(args) > 1 or (args and args[0] not in ("grant", "revoke")): sys.exit("usage: bench consent [grant|revoke]")
        if args: request["action"] = args[0]
    elif verb == "fold":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench fold PATH [WIDTH]")
        request["path"] = os.path.abspath(args[0])
        if len(args) == 2: request["width"] = float(args[1])
    elif verb == "little":
        if len(args) != 1: sys.exit("usage: bench little URL|keep|close")
        request["what"] = args[0]
    elif verb == "site":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench site PATH [security|permissions]")
        request["path"] = os.path.abspath(args[0])
        if len(args) == 2:
            request["security"] = args[1] == "security"
            request["permissions"] = args[1] == "permissions"
    elif verb == "column":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench column PATH [HEIGHT]")
        request["path"] = os.path.abspath(args[0])
        if len(args) == 2: request["height"] = float(args[1])
    elif verb == "space":
        if args and args[0] == "new":
            fresh = args[-1] == "fresh"
            request["action"], request["name"], request["fresh"] = "new", " ".join(args[1:-1] if fresh else args[1:]) or "Test", fresh
        elif args and args[0] == "go" and len(args) == 2: request["action"], request["index"] = "go", int(args[1])
        elif args and args[0] == "delete": request["action"] = "delete"
        elif args and args[0] == "swipe" and len(args) == 2: request["action"], request["dx"] = "swipe", float(args[1])
        elif args and args[0] == "hold" and len(args) == 2: request["action"], request["dx"] = "hold", float(args[1])
        elif args and args[0] == "release": request["action"] = "release"
        elif args and args[0] == "move" and len(args) == 2: request["action"], request["index"] = "move", int(args[1])
        elif args: sys.exit("usage: bench space [new NAME | go N | delete | swipe DX | hold DX | release | move N]")
    elif verb == "hit":
        if len(args) not in (2, 3) or (len(args) == 3 and args[2] not in ("double", "middle")): sys.exit("usage: bench hit X Y [double|middle]")
        request["x"], request["y"] = float(args[0]), float(args[1])
        if len(args) == 3: request[args[2]] = True
    elif verb == "place":
        if len(args) != 2: sys.exit("usage: bench place ID INDEX")
        request["id"], request["to"] = args[0], int(args[1])
    elif verb == "pin":
        if args == ["clear"]: request["how"] = "clear"
        elif len(args) == 2 and args[1] in ("essential", "line", "none", "close"): request["id"], request["how"] = args
        else: sys.exit("usage: bench pin ID essential|line|none|close, or bench pin clear")
    elif verb == "leave":
        if args not in ([], ["stay"], ["go"]): sys.exit("usage: bench leave [stay|go]")
        if args: request["action"] = args[0]
    elif verb == "close-after":
        if not 1 <= len(args) <= 2 or (len(args) == 2 and args[1] not in ("close", "others")): sys.exit("usage: bench close-after ID [close|others]")
        request["id"], request["close"], request["others"] = args[0], args[1:] == ["close"], args[1:] == ["others"]
    elif verb == "field":
        if not args or any(a not in ("type", "go") for a in args[1:]): sys.exit("usage: bench field TEXT [type] [go]")
        request["text"] = args[0]
        request["type"] = "type" in args[1:]
        request["go"] = "go" in args[1:]
    elif verb == "bookmark":
        if len(args) not in (1, 2) or (len(args) == 2 and args[1] != "new"): sys.exit("usage: bench bookmark URL [new]")
        request["url"] = args[0]
        request["new"] = len(args) == 2
    elif verb == "history":
        if args not in ([], ["clear"]): sys.exit("usage: bench history [clear]")
        if args: request["action"] = "clear"
    elif verb == "menu":
        if args not in ([], ["open"]): sys.exit("usage: bench menu [open]")
        request["open"] = args == ["open"]
    elif verb == "transfer":
        if len(args) > 1: sys.exit("usage: bench transfer [NAME]")
        if args: request["bring"] = args[0]
    elif verb == "keyeq":
        if len(args) < 2 or any(a != "shift" for a in args[2:]): sys.exit("usage: bench keyeq CHARS CODE [shift]")
        request["chars"], request["code"], request["mods"] = args[0], int(args[1]), args[2:]
    elif verb == "find":
        usage = "usage: bench find [TEXT [type] | next|previous [N] | close]"
        if not args: request["action"] = "state"
        elif args[0] in ("next", "previous") and len(args) <= 2:
            request["action"] = args[0]
            if len(args) == 2: request["times"] = int(args[1])
        elif args == ["close"]: request["action"] = "close"
        elif len(args) == 1 or args[1:] == ["type"]: request["text"], request["type"] = args[0], len(args) == 2
        else: sys.exit(usage)
    elif verb == "peek":
        if len(args) != 1: sys.exit("usage: bench peek URL|close")
        request["url"] = args[0]
    elif verb == "pull":
        if len(args) not in (1, 2, 3): sys.exit("usage: bench pull DX [STEPS] [MS]")
        request["dx"] = float(args[0])
        if len(args) > 1: request["steps"] = int(args[1])
        if len(args) > 2: request["ms"] = float(args[2])
    elif verb == "downloads":
        if not args: pass
        elif args[0] == "fetch" and len(args) == 3: request["action"], request["id"], request["url"] = args
        elif args[0] in ("pause", "resume", "cancel", "restart", "remove") and len(args) == 2:
            request["action"], request["n"] = args[0], int(args[1])
        elif args in (["clear"], ["quit"], ["pdf-save"]): request["action"] = args[0]
        elif args[0] == "list" and len(args) == 2: request["action"], request["path"] = "list", os.path.abspath(args[1])
        elif args[0] == "popover" and len(args) == 2: request["action"], request["on"] = "popover", args[1] == "on"
        elif args[0] == "hand" and len(args) == 2: request["action"], request["path"] = "hand", os.path.abspath(args[1])
        else: sys.exit("usage: bench downloads [fetch ID URL | pause|resume|cancel|restart|remove N | clear | quit]")
    elif verb == "files":
        if not args or args[0] not in ("open", "import", "export", "menu"): sys.exit("usage: bench files open PATH…|import PATH|export PATH|menu")
        request["action"] = args[0]
        request["paths"] = [os.path.abspath(p) for p in args[1:]]
    elif verb == "permit":
        if args:
            request["action"] = args[0]
            if args[0] == "set":
                if len(args) != 4: sys.exit("usage: bench permit set HOST KIND allow|block|ask")
                request["host"], request["kind"], request["choice"] = args[1], args[2], args[3]
            elif args[0] == "forget" and len(args) == 2:
                request["host"] = args[1]
            elif args[0] == "ask" and len(args) == 2:
                request["kind"] = args[1]
            elif args[0] == "picture":
                if len(args) != 2: sys.exit("usage: bench permit picture PATH")
                request["path"] = os.path.abspath(args[1])
    elif verb == "translate":
        if not 1 <= len(args) <= 2 or (len(args) == 2 and args[1] not in ("on", "off", "read")): sys.exit("usage: bench translate ID [on|off|read]")
        request["id"] = args[0]
        if len(args) == 2: request["action"] = args[1]
    elif verb == "autofill":
        if args:
            request["action"] = args[0]
            if args[0] == "add-contact":
                request["fields"] = dict(a.split("=", 1) for a in args[1:])
            elif args[0] == "add-card":
                if len(args) < 3: sys.exit("usage: bench autofill add-card NUMBER MM/YYYY [NAME]")
                month, year = args[2].split("/")
                request["fields"] = {"number": args[1], "month": month, "year": year, "name": " ".join(args[3:])}
            elif args[0] == "pick":
                request["n"] = int(args[1]) if len(args) > 1 else 0
            elif args[0] == "picture":
                if len(args) != 2: sys.exit("usage: bench autofill picture PATH")
                request["path"] = os.path.abspath(args[1])
    elif verb == "sync":
        if len(args) > 1 or (args and args[0] not in ("state", "use", "keep", "add")): sys.exit("usage: bench sync [state|use|keep|add]")
        if args: request["action"] = args[0]
    elif verb in ("window", "windowfs", "front"):
        pass
    elif verb == "pages":
        if len(args) != 1 or args[0] not in ("on", "off"): sys.exit("usage: bench pages on|off")
        request["on"] = args[0] == "on"
    elif verb == "picture":
        if len(args) != 1: sys.exit("usage: bench picture PATH")
        request["path"] = os.path.abspath(args[0])
    elif verb == "film":
        if len(args) not in (2, 3, 4) or args[0] not in ("peek", "unpeek", "fold", "none"):
            sys.exit("usage: bench film peek|unpeek|fold|none PATH [FRAMES] [EVERY]")
        request["action"], request["path"] = args[0], os.path.abspath(args[1])
        if len(args) > 2: request["frames"] = int(args[2])
        if len(args) > 3: request["every"] = float(args[3])
    elif verb not in ("tabs", "probe", "extensions"):
        sys.exit(f"unknown command “{verb}” — see bench help")

    answer = ask(os.path.join(folder(world), "bench.sock"), request)
    if "error" in answer:
        sys.exit("error: " + str(answer["error"]))
    if verb == "text":
        print(answer.get("text", ""))
        if answer.get("truncated"):
            print("\n[… truncated]", file=sys.stderr)
    elif verb == "shot":
        print(answer["path"])
    elif verb in ("open", "ext-page"):
        print(answer["id"])
    elif verb in ("eval", "ext-popup"):
        value = answer.get("value")
        print(value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, indent=2))
    elif verb == "downloads":
        print(f"{answer.get('count', 0)} coming in, overall {answer.get('overall', -1):.2f}; button {answer.get('button')} "
              f"trips={answer.get('trips')} landings={answer.get('landings')} "
              f"finale={answer.get('finale') or '-'} said={answer.get('said') or '-'} dock={answer.get('badge') or '-'}")
        for d in answer.get("items", []):
            left = f" {d['left']}s left" if d.get("left", -1) >= 0 else ""
            keep = " (resumable)" if d.get("resumable") else ("" if d.get("retryable", True) else " (can't retry)")
            print(f"  #{d['n']} {d['state']:<10} {d['received']}/{d['expected']} {d['speed']} B/s{left}{keep}  {d['name']}")
    elif verb == "tabs":
        for tab in answer.get("tabs", []):
            mark = "⚗" if tab.get("bench") else ("●" if tab.get("active") else " ")
            state = " …" if tab.get("loading") else (" z" if tab.get("asleep") else "")
            print(f"{mark} {tab['id']}  {tab.get('title') or '—'}  {tab.get('url')}{state}")
    else:
        print(json.dumps(answer, ensure_ascii=False, indent=2))
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
